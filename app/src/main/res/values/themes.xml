<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window-chrome only. The app is 100% Compose and gets every colour from
      MetroVaultTheme's ColorScheme (core/ui/theme), so this theme's sole job is
      the pre-Compose window: no action bar, correct background while the first
      frame is drawn, and system-bar colours.

      Parent was Theme.Material3.Dark.NoActionBar, which existed only to satisfy
      ~24 colorPrimary/colorSurface/colorTertiary attributes that nothing in a
      Compose app ever reads — and which forced a dependency on
      com.google.android.material (plus constraintlayout, recyclerview,
      viewpager2, coordinatorlayout, cardview, transition and dynamicanimation).
      Those attributes and that dependency are gone.

      It must stay AppCompat-derived, though, and NOT drop to a plain framework
      theme: on API 26–27 androidx.biometric falls back to
      FingerprintDialogFragment, whose onCreateDialog builds an
      androidx.appcompat.app.AlertDialog against the host activity's theme. A
      non-AppCompat theme there throws "You need to use a Theme.AppCompat theme
      (or descendant)" and breaks biometric unlock on min-SDK devices. appcompat
      is on the classpath regardless — androidx.biometric requires it — so this
      parent costs nothing extra in dependencies.
    -->
    <style name="Theme.MetroVault" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen Theme - follows system day/night mode -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.MetroVault</item>
    </style>
</resources>
